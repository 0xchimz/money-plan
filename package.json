{
  "name": "money-plan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply money-plan --local",
    "db:seed:demo": "wrangler d1 execute money-plan --local --file scripts/seed-demo.sql",
    "deploy": "pnpm build && wrangler d1 migrations apply money-plan --remote && wrangler deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.9",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.85.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.143.0"
  }
}
